rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    function isSuperAdminEmail() { 
      return isAuthenticated() && request.auth.token.email == 'pipeloco3050@gmail.com'; 
    }
    
    function isAdmin() { 
      return isAuthenticated() && (
        isSuperAdminEmail() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 2
      ); 
    }
    
    function isCoordinador() { 
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 1; 
    }

    match /users/{userId} {
      allow read: if true; 
      allow write: if isAuthenticated() && (
        request.auth.uid == userId || isSuperAdminEmail() || isAdmin() || isCoordinador()
      );
    }

    match /bosques/{bosqueId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); 
    }

    match /miembros/{miembroId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /solicitudes/{solicitudId} {
      allow read, write: if isAuthenticated();
    }
    
    match /cursos/{cursoId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdminEmail() || isAdmin();
    }

    match /mensajes/{mensajeId} {
      allow read, create: if isAuthenticated();
      allow delete, update: if isAdmin() || isSuperAdminEmail();
    }

    match /bosques/{bosqueId}/mensajes/{mensajeId} {
      allow read, write: if isAuthenticated();
    }

    // FEED DE PUBLICACIONES
    match /publicaciones/{publicacionId} {
      allow read: if isAuthenticated();
      // Solo coordinadores o administradores pueden CREAR o ELIMINAR publicaciones completas
      allow create: if isCoordinador() || isAdmin() || isSuperAdminEmail();
      allow delete: if isCoordinador() || isAdmin() || isSuperAdminEmail();
      
      // PERMITIR ACTUALIZAR:
      // 1. Coordinadores / Admin (para editar)
      // 2. CUALQUIER usuario autenticado cuando cambia el contador de likesCount o commentsCount
      allow update: if isCoordinador() || isAdmin() || isSuperAdminEmail() || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );

      // SUBCOLECCIÓN DE LIKES: Cualquier usuario autenticado puede crear/borrar su propio like
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      }

      // SUBCOLECCIÓN DE COMENTARIOS: Cualquier usuario autenticado puede comentar
      match /comentarios/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.usuarioId ||
          isCoordinador() ||
          isAdmin() ||
          isSuperAdminEmail()
        );
      }
    }

    // EVENTOS Y CALENDARIO
    match /eventos/{eventoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCoordinador() || isAdmin() || isSuperAdminEmail();
    }

    match /inscripciones/{inscripcionId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || 
        isAdmin() || isSuperAdminEmail() ||
        (isCoordinador() && resource.data.bosqueId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bosqueId)
      );
      allow create: if isAuthenticated() && 
        request.resource.data.uid == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bosqueId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bosqueId != '';
      allow update: if isAuthenticated() && (
        isAdmin() || isSuperAdminEmail() ||
        (resource.data.uid == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['revisadoPor', 'revisadoAt', 'motivo'])) ||
        (isCoordinador() && resource.data.bosqueId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bosqueId && request.auth.uid != resource.data.uid)
      );
      allow delete: if isAdmin() || isSuperAdminEmail();
    }

    // NOTIFICACIONES
    match /notificaciones/{userId} {
      allow read, write: if isAuthenticated();
      match /items/{notifId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /{document=**} {
      allow read, write: if isSuperAdminEmail();
    }
  }
}
